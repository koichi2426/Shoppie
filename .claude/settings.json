{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/trials-record-check.sh\" check",
            "timeout": 10,
            "statusMessage": "試行の記録を確認中"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/trials-record-check.sh\" start",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
