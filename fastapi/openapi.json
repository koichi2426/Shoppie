{
  "openapi": "3.1.0",
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/request-assistance": {
      "post": {
        "summary": "Request Assistance",
        "operationId": "request_assistance_request_assistance_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestAssistanceBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestAssistanceResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/context/{context_id}": {
      "delete": {
        "summary": "Delete Context",
        "operationId": "delete_context_context__context_id__delete",
        "parameters": [
          {
            "name": "context_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Context Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteContextResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/events": {
      "post": {
        "summary": "Record Interaction Event",
        "operationId": "record_interaction_event_events_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "product_click",
                      "conversation_reset"
                    ],
                    "title": "Type"
                  },
                  "context_id": {
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 1,
                    "title": "Context Id"
                  },
                  "turn_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 64
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Turn Id"
                  },
                  "rank": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "maximum": 1000.0,
                        "minimum": 1.0
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Rank",
                    "description": "返答の中での商品の表示順(1 始まり)"
                  },
                  "marketplace": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 32
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Marketplace"
                  },
                  "price_yen": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0.0
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Price Yen"
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "type",
                  "context_id"
                ],
                "title": "InteractionEventBody"
              }
            },
            "text/plain": {
              "schema": {
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "product_click",
                      "conversation_reset"
                    ],
                    "title": "Type"
                  },
                  "context_id": {
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 1,
                    "title": "Context Id"
                  },
                  "turn_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 64
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Turn Id"
                  },
                  "rank": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "maximum": 1000.0,
                        "minimum": 1.0
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Rank",
                    "description": "返答の中での商品の表示順(1 始まり)"
                  },
                  "marketplace": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 32
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Marketplace"
                  },
                  "price_yen": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0.0
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Price Yen"
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "type",
                  "context_id"
                ],
                "title": "InteractionEventBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentResponseSchema": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "products": {
            "items": {
              "$ref": "#/components/schemas/ProductSchema"
            },
            "type": "array",
            "title": "Products"
          }
        },
        "type": "object",
        "required": [
          "message",
          "products"
        ],
        "title": "AgentResponseSchema"
      },
      "DeleteContextResponse": {
        "properties": {
          "context_id": {
            "type": "string",
            "title": "Context Id"
          },
          "deleted": {
            "type": "boolean",
            "title": "Deleted"
          }
        },
        "type": "object",
        "required": [
          "context_id",
          "deleted"
        ],
        "title": "DeleteContextResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProductSchema": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "price": {
            "type": "integer",
            "title": "Price"
          },
          "image_urls": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Image Urls"
          },
          "affiliate_url": {
            "type": "string",
            "title": "Affiliate Url"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "marketplace": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Marketplace"
          }
        },
        "type": "object",
        "required": [
          "title",
          "price",
          "image_urls",
          "affiliate_url"
        ],
        "title": "ProductSchema"
      },
      "RequestAssistanceBody": {
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text"
          },
          "context_id": {
            "type": "string",
            "minLength": 1,
            "title": "Context Id"
          }
        },
        "type": "object",
        "required": [
          "text",
          "context_id"
        ],
        "title": "RequestAssistanceBody"
      },
      "RequestAssistanceResponse": {
        "properties": {
          "response": {
            "$ref": "#/components/schemas/AgentResponseSchema"
          },
          "turn_id": {
            "type": "string",
            "title": "Turn Id",
            "description": "この往復の識別子。商品のクリックなどの反応に付けて送り返す"
          },
          "config_version": {
            "type": "string",
            "title": "Config Version",
            "description": "返答を作ったエージェント構成の識別子"
          }
        },
        "type": "object",
        "required": [
          "response",
          "turn_id",
          "config_version"
        ],
        "title": "RequestAssistanceResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
